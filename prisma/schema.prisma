generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model UnitRate {
  id            String   @id @default(cuid())
  itemName      String   @db.VarChar(191)
  itemKey       String   @unique @db.VarChar(191)
  rate          Float
  unit          String   @default("meter") @db.VarChar(50)
  effectiveDate DateTime @default(now())
  active        Boolean  @default(true)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model UnitRateHistory {
  id        String   @id @default(cuid())
  itemKey   String   @db.VarChar(191)
  itemName  String   @db.VarChar(191)
  oldRate   Float
  newRate   Float
  unit      String   @db.VarChar(50)
  changedAt DateTime @default(now())
  notes     String?  @db.Text
}

model DropdownValue {
  id        String   @id @default(cuid())
  category  String   @db.VarChar(100) // SOURCE, TECHNICIAN, PAYMENT_METHOD, INVENTORY_ITEM
  value     String   @db.VarChar(100)
  color     String?  @db.VarChar(50)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, value])
}

model CrmJob {
  branch         String @default("Karachi") @db.VarChar(50)
  id             String @id @default(cuid())
  sn             Int // Monthly sequential counter (resets to 1 each month)
  date           String @db.VarChar(20) // "YYYY-MM-DD"
  monthKey       String @db.VarChar(20) // "YYYY-MM"
  clientName     String @db.VarChar(191)
  contactNo      String @db.VarChar(50)
  addressArea    String @db.Text
  source         String @db.VarChar(100) // "Direct", "MJD/MTP", "Sarah South", etc.
  technicianName String @db.VarChar(100) // "Team Alpha", "Team Ali", etc.

  // Material Usage & Locked Unit Rates
  cable16mmMeter     Float @default(0)
  cable16mmUnitCost  Float @default(0) // Locked in at time of creation!
  cable16mmTotalCost Float @default(0)

  cable10mmMeter     Float @default(0)
  cable10mmUnitCost  Float @default(0) // Locked in at time of creation!
  cable10mmTotalCost Float @default(0)

  cable6mmMeter     Float @default(0)
  cable6mmUnitCost  Float @default(0) // Locked in at time of creation!
  cable6mmTotalCost Float @default(0)

  breakerBoxQty       Float @default(0)
  breakerBoxUnitCost  Float @default(0) // Locked in at time of creation!
  breakerBoxTotalCost Float @default(0)

  // Additional Materials tracked in inventory & Locked Unit Rates
  earthingRodQty       Float @default(0)
  earthingRodUnitCost  Float @default(0) // Locked in at time of creation!
  earthingRodTotalCost Float @default(0)

  wpbQty       Float @default(0)
  wpbUnitCost  Float @default(0) // Locked in at time of creation!
  wpbTotalCost Float @default(0)

  ninUvrQty       Float @default(0)
  ninUvrUnitCost  Float @default(0) // Locked in at time of creation!
  ninUvrTotalCost Float @default(0)

  rcboBreakerQty       Float @default(0)
  rcboBreakerUnitCost  Float @default(0) // Locked in at time of creation!
  rcboBreakerTotalCost Float @default(0)

  // Additional Supply and Misc Expenses
  additionalSupplyName String @default("") @db.VarChar(191)
  additionalSupplyCost Float  @default(0)
  miscExp              Float  @default(0)

  // EV Vehicle Brand
  vehicleBrand String? @default("BYD") @db.VarChar(50)

  // Calculated Financials
  totalJobCost      Float @default(0) // 16mm + 10mm + 6mm cost + breaker cost + additionalSupplyCost + miscExp
  billAmount        Float @default(0) // Manual input
  grossProfit       Float @default(0) // billAmount - totalJobCost
  grossProfitMargin Float @default(0) // (grossProfit / billAmount) * 100

  // Payment Details & Status
  payStatus     String  @default("Trade Receivable") @db.VarChar(50) // "Paid" | "Trade Receivable" | "Voucher"
  paymentStatus String  @default("Trade Receivable") @db.VarChar(50) // "Paid" | "Trade Receivable" | "Voucher"
  paymentMethod String  @default("Cash") @db.VarChar(50) // "Cash" | "Bank" | "BYD Voucher"
  paidDate      String? @db.VarChar(20)

  // BYD Voucher Workflow Tracking
  isVoucher                Boolean   @default(false)
  voucherGrossAmount       Float?    @default(65000)
  voucherDeduction         Float?    @default(13850)
  voucherNetClaim          Float?    @default(51150)
  voucherSettled           Boolean   @default(false)
  voucherSettledDate       DateTime?
  customerExcessPaid       Float?    @default(0)
  customerExcessReceivable Float?    @default(0)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([monthKey])
  @@index([date])
  @@index([payStatus])
  @@index([paymentStatus])
  @@index([vehicleBrand])
  @@index([isVoucher])
  @@index([voucherSettled])
  @@index([source])
  @@index([technicianName])
}

model InventoryLedger {
  branch       String   @default("Karachi") @db.VarChar(50)
  id           String   @id @default(cuid())
  date         String   @db.VarChar(20) // "YYYY-MM-DD"
  monthKey     String   @db.VarChar(20) // "YYYY-MM"
  itemName     String   @db.VarChar(191) // e.g. "10mm Cable", "6mm Cable", "DB Box", "Earthing Rod", "WPB", "NIN UVR", "RCBO Breaker"
  itemKey      String   @db.VarChar(100) // "cable_10mm", "cable_6mm", "breaker_box", etc.
  unit         String   @default("meter") @db.VarChar(50)
  karachiQty   Float    @default(0)
  lahoreQty    Float    @default(0)
  openingStock Float    @default(0)
  usedQty      Float    @default(0)
  restockQty   Float    @default(0)
  closingStock Float    @default(0)
  notes        String?  @db.Text
  referenceId  String?  @db.VarChar(191)
  movementType String?  @default("CRM_USAGE") @db.VarChar(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([date, itemKey, branch])
  @@index([monthKey])
  @@index([date])
  @@index([referenceId])
  @@index([movementType])
}

model VendorPurchase {
  branch        String   @default("Karachi") @db.VarChar(50)
  id            String   @id @default(cuid())
  date          String   @db.VarChar(20) // "YYYY-MM-DD"
  monthKey      String   @db.VarChar(20) // "YYYY-MM"
  vendorName    String   @db.VarChar(191)
  invoiceNo     String   @default("") @db.VarChar(100)
  item          String   @db.VarChar(191)
  itemKey       String   @db.VarChar(100)
  quantity      Float
  unitRate      Float
  totalAmount   Float
  paymentMethod String   @default("Bank") @db.VarChar(50) // "Cash" | "Bank" | "Unpaid"
  settledDate   String?  @db.VarChar(20) // Settlement date when payment is made
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([monthKey])
  @@index([date])
  @@index([paymentMethod])
  @@index([branch])
}

model AppConfig {
  id          String   @id @default(cuid())
  key         String   @unique @db.VarChar(191)
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt
}

model GeneralExpense {
  branch        String   @default("Karachi") @db.VarChar(50)
  id            String   @id @default(cuid())
  date          String   @db.VarChar(20) // "YYYY-MM-DD"
  monthKey      String   @db.VarChar(20) // "YYYY-MM"
  category      String   @db.VarChar(191) // Free-text, e.g. "Office Rent", "Stationery", "Generator Fuel", "Tea & Refreshments"
  amount        Float
  paymentMethod String   @default("Cash") @db.VarChar(50) // "Cash" | "Bank"
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([monthKey])
  @@index([date])
  @@index([paymentMethod])
  @@index([category])
}

model Employee {
  branch                String          @default("Karachi") @db.VarChar(50)
  id                    String          @id @default(cuid())
  name                  String          @db.VarChar(191)
  designation           String          @db.VarChar(191) // e.g. Installer, Supervisor, Manager, Lead Electrician
  baseSalary            Float           @default(0) // Monthly Base Salary (PKR)
  defaultFuelAllocation Float           @default(0) // Default Monthly Fuel Allocation (PKR)
  contactNo             String?         @db.VarChar(50)
  dateOfJoining         String?         @db.VarChar(20) // "YYYY-MM-DD"
  active                Boolean         @default(true)
  notes                 String?         @db.Text
  advances              SalaryAdvance[]
  payrollRecords        PayrollRecord[]
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

model SalaryAdvance {
  branch         String   @default("Karachi") @db.VarChar(50)
  id             String   @id @default(cuid())
  employeeId     String   @db.VarChar(191)
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date           String   @db.VarChar(20) // "YYYY-MM-DD"
  monthKey       String   @db.VarChar(20) // "YYYY-MM"
  amount         Float // Advance Amount (PKR)
  paymentMethod  String   @default("Cash") @db.VarChar(50) // "Cash" | "Bank"
  deductedAmount Float    @default(0)
  status         String   @default("Active") @db.VarChar(50) // "Active" | "Settled"
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([employeeId])
  @@index([monthKey])
  @@index([date])
}

model PayrollRecord {
  branch                String   @default("Karachi") @db.VarChar(50)
  id                    String   @id @default(cuid())
  employeeId            String   @db.VarChar(191)
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date                  String   @db.VarChar(20) // "YYYY-MM-DD"
  monthKey              String   @db.VarChar(20) // "YYYY-MM"
  baseSalary            Float    @default(0) // Base Salary (or partial payout entered)
  overtimeAmount        Float    @default(0) // Overtime Amount (PKR)
  foodIncentive         Float    @default(0) // Food Incentive Amount (PKR)
  fuelIncentive         Float    @default(0) // Fuel Incentive Amount (PKR)
  installationIncentive Float    @default(0) // Installation Incentive Amount (PKR)
  totalGrossEarnings    Float    @default(0) // Base Salary + Overtime + Food + Fuel + Installation
  advanceDeduction      Float    @default(0) // Advance Salary Deduction
  netPayable            Float    @default(0) // Total Gross Earnings - Advance Salary Deduction
  paymentMethod         String   @default("Bank") @db.VarChar(50) // "Cash" | "Bank"
  notes                 String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([employeeId])
  @@index([monthKey])
  @@index([date])
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique @db.VarChar(191)
  passwordHash String   @db.VarChar(255)
  role         String   @default("viewer") @db.VarChar(50) // "admin" | "viewer"
  name         String?  @db.VarChar(191)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
